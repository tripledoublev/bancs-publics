<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_meetup_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_circle_button">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trouver un banc entre les deux"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Le point d'équilibre • Se retrouver à mi-chemin"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Fermer"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Explanatory Swiss Concept Card -->
    <LinearLayout
        android:id="@+id/card_meetup_explainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_chip_counter"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plutôt que de chercher où vous retrouver, BenchMap calcule le banc idéal situé exactement à mi-chemin entre vous et un proche. Votre position est floutée (~300m) pour préserver votre vie privée. Zéro compte, zéro serveur, 100% hors-ligne."
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <!-- Tab Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_btn_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1. INVITER UN AMI"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_btn_join"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2. REJOINDRE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- ================= TAB 1: GENERATE / SHARE KEY ================= -->
    <LinearLayout
        android:id="@+id/layout_tab_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Envoyez cette invitation confidentielle. Dès que votre proche l'ouvre, vos bancs à mi-chemin apparaîtront sur la carte :"
            android:textSize="11.5sp"
            android:textColor="@color/text_muted" />

        <!-- Link Display Box -->
        <LinearLayout
            android:id="@+id/box_key_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_counter">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIEN DE RENCONTRE CONFIDENTIEL"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/tv_generated_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="benchmap://meet?k=BM1-...."
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Share & Copy Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_invite"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.6"
                android:text="↗ PARTAGER L'INVITATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_key"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📋 COPIER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= TAB 2: INPUT FRIEND KEY ================= -->
    <LinearLayout
        android:id="@+id/layout_tab_join"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Collez le lien ou la clé reçue pour calculer l'épicentre et révéler les bancs à mi-chemin :"
            android:textSize="11.5sp"
            android:textColor="@color/text_muted" />

        <EditText
            android:id="@+id/et_friend_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_counter"
            android:hint="Collez le lien ou la clé (BM1-...)"
            android:inputType="textUri|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste_key"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📋 COLLER DU PRESSE-PAPIER"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:elevation="0dp" />

            <TextView
                android:id="@+id/tv_key_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Clé invalide"
                android:textSize="11sp"
                android:textColor="@color/swiss_red"
                android:visibility="invisible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_calculate_meetup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="🔍 TROUVER LES BANCS À MI-CHEMIN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
