<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_meetup_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_circle_button">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤝 Rendez-vous à mi-chemin"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="100% anonyme, chiffré et local (zéro serveur)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Fermer"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Segmented Tab Switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_chip_counter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_btn_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PARTAGER MA CLÉ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="8dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tab_btn_join"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ENTRER UNE CLÉ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="8dp"
            app:elevation="0dp" />
    </LinearLayout>

    <!-- ================= TAB 1: GENERATE / SHARE KEY ================= -->
    <LinearLayout
        android:id="@+id/layout_tab_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIDENTIALITÉ DU LIEU :"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_muted" />

        <!-- Privacy Blur Selector Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/chip_blur_exact"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🎯 Précis"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_attribute"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chip_blur_discreet"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="🔒 Flou ~150 m"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_attribute"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chip_blur_district"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="🏘 Quartier"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_attribute"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Monospace Key Display Box -->
        <LinearLayout
            android:id="@+id/box_key_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_counter">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOTRE CLÉ DE RENCONTRE"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/tv_generated_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="BM1-...."
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Share & Copy Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_key"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="📋 COPIER"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_invite"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.6"
                android:text="↗ PARTAGER (SMS / SIGNAL)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ================= TAB 2: INPUT FRIEND KEY ================= -->
    <LinearLayout
        android:id="@+id/layout_tab_join"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLÉ REÇUE DE VOTRE AMI :"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textColor="@color/text_muted" />

        <EditText
            android:id="@+id/et_friend_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_counter"
            android:hint="Collez la clé ou le lien reçu"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_paste_key"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📋 COLLER DU PRESSE-PAPIER"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:elevation="0dp" />

            <TextView
                android:id="@+id/tv_key_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Clé invalide"
                android:textSize="11sp"
                android:textColor="@color/swiss_red"
                android:visibility="invisible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_calculate_meetup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="🔍 TROUVER LES BANCS À MI-CHEMIN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
