<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_add_custom_bench_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Drag Handle -->
        <View
            android:id="@+id/drag_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip_counter" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_custom_dialog_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nouveau banc public"
                    android:textColor="@color/swiss_black"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_custom_bench_coords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="◆ 45.50172° N, 73.56731° W"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_custom_dialog_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Fermer"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp" />

        <!-- 1. Name & Location Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOM DU BANC OU REPÈRE"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_custom_bench_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Ex: Banc sous le grand saule, Face au canal"
                android:textColor="@color/swiss_black"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_chip_attribute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="RUE, PARC OU LIEU"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_custom_bench_location"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:hint="Ex: Rue Wellington, Parc La Fontaine"
                android:textColor="@color/swiss_black"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_chip_attribute" />
        </LinearLayout>

        <!-- 2. Attributes Section (Material & Backrest) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATÉRIAU"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_material_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_mat_wood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_attribute"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Bois"
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/chip_mat_metal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_attribute"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Métal"
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/chip_mat_concrete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_attribute"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Béton"
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/chip_mat_stone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_attribute"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Pierre"
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/chip_mat_other"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_attribute"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Autre"
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="DOSSIER"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/layout_backrest_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_backrest_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="Avec dossier"
                    android:textColor="@color/swiss_black"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/chip_backrest_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="Sans dossier"
                    android:textColor="@color/swiss_black"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Notes Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTE PERSONNELLE (OPTIONNELLE)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/et_custom_bench_note"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="6dp"
                android:gravity="top|start"
                android:padding="12dp"
                android:hint="Vos observations privées (ensoleillement, tranquillité, vue, état...)"
                android:textColor="@color/swiss_black"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:background="@drawable/bg_chip_attribute" />
        </LinearLayout>

        <!-- 4. Photos Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHOTOS DU BANC (LOCAL SUR L'APPAREIL)"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-medium" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/layout_custom_photos_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Add Photo Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_custom_add_photo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/card_border"
                        app:cardBackgroundColor="@color/chip_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/iv_custom_add_photo_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/swiss_black" />

                            <TextView
                                android:id="@+id/tv_custom_add_photo_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="+ Photo"
                                android:textColor="@color/swiss_black"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Dynamically populated photo thumbnails go here -->
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 5. Confirm Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_custom_bench_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ENREGISTRER DANS MES BANCS ◆"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/swiss_red"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
