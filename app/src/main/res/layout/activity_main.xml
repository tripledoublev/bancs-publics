<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Native Canvas Map View (Full Island Vector Streets & Benches) -->
    <com.machine.benchmap.MontrealBenchMapView
        android:id="@+id/bench_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Swiss Minimalist Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="0dp"
        android:clipToPadding="false">

        <!-- Clean Swiss Title Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Left: Bench counter badge with live indicator dot -->
                <LinearLayout
                    android:id="@+id/layout_counter_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip_counter"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_swiss"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_bench_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9 602 BANCS"
                        android:textColor="@color/swiss_black"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Spacer pushing action controls cleanly to the right -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Action icons cluster -->
                <ImageView
                    android:id="@+id/btn_map_style"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Styles de rendu cartographique"
                    android:padding="7dp"
                    android:src="@drawable/ic_palette" />

                <ImageView
                    android:id="@+id/btn_collections"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mes collections de bancs"
                    android:padding="7dp"
                    android:src="@drawable/ic_bookmark" />

                <ImageView
                    android:id="@+id/btn_meetup"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Trouvez un banc entre les deux"
                    android:padding="7dp"
                    android:src="@drawable/ic_meetup" />

                <ImageView
                    android:id="@+id/btn_theme_toggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mode sombre"
                    android:padding="7dp"
                    android:src="@drawable/ic_theme_moon" />

                <com.machine.benchmap.SwissCompassView
                    android:id="@+id/btn_compass"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Boussole et orientation Nord"
                    android:padding="5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rendez-vous Active Status Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_meetup_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#3B82F6"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_blue"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_meetup_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤝 RENDEZ-VOUS ACTIF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2563EB" />

                    <TextView
                        android:id="@+id/tv_meetup_banner_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ami à 3,2 km • 15 bancs à mi-chemin"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_meetup_cycle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SUIVANT"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/btn_meetup_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Quitter le mode rendez-vous"
                    app:tint="@color/text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. Floating Action Controls (Right Bottom Dock) -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:fabSize="mini"
            app:backgroundTint="@color/bg_card"
            app:tint="@color/swiss_black"
            app:elevation="2dp"
            android:contentDescription="Ma position"
            android:src="@android:drawable/ic_menu_mylocation" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🔍 RECHERCHE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:cornerRadius="22dp"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/swiss_black"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:elevation="2dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🎲 AU HASARD"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:cornerRadius="22dp"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/swiss_black"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:elevation="2dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nearest"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="🧭 LE PLUS PROCHE"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:cornerRadius="22dp"
                android:backgroundTint="@color/swiss_black"
                android:textColor="#FFFFFF"
                app:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Detail Card (Refined Bottom Sheet Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title & Close & Distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_bench_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rue du Centre"
                        android:textColor="@color/swiss_black"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tv_bench_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Banc public • Montréal"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bench_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 m"
                    android:background="@drawable/bg_chip_distance"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/swiss_red"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="8dp" />

                <!-- Bookmark / Favorite Button -->
                <ImageView
                    android:id="@+id/btn_card_favorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/ic_bookmark"
                    android:contentDescription="Ajouter à une liste"
                    app:tint="@color/text_secondary" />

                <!-- Random Next Button -->
                <ImageView
                    android:id="@+id/btn_card_random"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@android:drawable/ic_popup_sync"
                    android:contentDescription="Autre banc au hasard"
                    app:tint="@color/text_secondary" />

                <!-- Close Button -->
                <ImageView
                    android:id="@+id/btn_close_detail"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Fermer"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Geographic Coordinates with click to copy -->
            <TextView
                android:id="@+id/tv_bench_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="45.48123° N, 73.56470° W"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Attribute Pills / Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tag_material"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"
                    android:text="Matériau: Standard"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tag_backrest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"
                    android:text="Dossier: Oui"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tag_seats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Places: Standard"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- User Saved Notes & Photos Section (if saved) -->
            <LinearLayout
                android:id="@+id/layout_detail_saved_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <!-- Collections badges -->
                <TextView
                    android:id="@+id/tv_detail_collections_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dans : ❤️ Coups de cœur"
                    android:textColor="@color/swiss_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />

                <!-- Note card -->
                <LinearLayout
                    android:id="@+id/card_detail_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝"
                        android:textSize="13sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_detail_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Note..."
                        android:textColor="@color/swiss_black"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Photos strip -->
                <HorizontalScrollView
                    android:id="@+id/scroll_detail_photos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout_detail_photos_strip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Prompt to save if not saved -->
            <TextView
                android:id="@+id/btn_detail_add_note_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="🔖 Ajouter à une liste"
                android:textColor="@color/swiss_red"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_navigate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="📍 ITINÉRAIRE PIÉTON"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:cornerRadius="14dp"
                    android:backgroundTint="@color/swiss_red"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="12dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="↗ PARTAGER"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:cornerRadius="14dp"
                    android:backgroundTint="@color/bg_light"
                    android:textColor="@color/swiss_black"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
