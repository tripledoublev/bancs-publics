<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- 1. Native Canvas Map View (Full Island Vector Streets & Benches) -->
    <com.machine.benchmap.MontrealBenchMapView
        android:id="@+id/bench_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Swiss Minimalist Header -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:clipToPadding="false">

        <!-- Clean Swiss Title Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_swiss"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Les bancs de Montréal"
                        android:textColor="@color/swiss_black"
                        android:textSize="13sp"
                        android:letterSpacing="0.02"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cartographie locale • v0.1.0"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bench_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9 602 BANCS"
                    android:background="@drawable/bg_chip_counter"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/swiss_black"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. Floating Action Controls (Right Bottom Dock) -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:fabSize="mini"
            app:backgroundTint="@color/bg_card"
            app:tint="@color/swiss_black"
            app:elevation="3dp"
            android:contentDescription="Ma position"
            android:src="@android:drawable/ic_menu_mylocation" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="🎲 AU HASARD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:cornerRadius="23dp"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/swiss_black"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:elevation="3dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nearest"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="🧭 LE PLUS PROCHE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:cornerRadius="23dp"
                android:backgroundTint="@color/swiss_black"
                android:textColor="#FFFFFF"
                app:elevation="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Detail Card (Refined Bottom Sheet Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Close & Distance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_bench_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rue du Centre"
                        android:textColor="@color/swiss_black"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_bench_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Banc public • Montréal"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bench_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 m"
                    android:background="@drawable/bg_chip_distance"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/swiss_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <!-- Random Next Button -->
                <ImageView
                    android:id="@+id/btn_card_random"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@android:drawable/ic_popup_sync"
                    android:contentDescription="Autre banc au hasard"
                    app:tint="@color/text_secondary" />

                <!-- Close Button -->
                <ImageView
                    android:id="@+id/btn_close_detail"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Fermer"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Geographic Coordinates with click to copy -->
            <TextView
                android:id="@+id/tv_bench_coords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="45.48123° N, 73.56470° W"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:padding="3dp" />

            <!-- Attribute Pills / Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tag_material"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="6dp"
                    android:text="Matériau: Standard"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tag_backrest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="6dp"
                    android:text="Dossier: Oui"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tag_seats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_attribute"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Places: Standard"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_navigate"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="📍 ITINÉRAIRE PIÉTON"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:cornerRadius="13dp"
                    android:backgroundTint="@color/swiss_red"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="↗ PARTAGER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    app:cornerRadius="13dp"
                    android:backgroundTint="#F8FAFC"
                    android:textColor="@color/swiss_black"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
