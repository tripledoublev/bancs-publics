<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Thumbnail or bench icon -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bench_thumb"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/chip_bg">

        <ImageView
            android:id="@+id/iv_bench_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_bookmark_filled"
            android:padding="14dp"
            app:tint="@color/swiss_red" />
    </androidx.cardview.widget.CardView>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_bench_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rue du Centre"
            android:textColor="@color/swiss_black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_bench_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Le Sud-Ouest • Près de Rue du Centre"
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Note Preview -->
        <TextView
            android:id="@+id/tv_bench_note_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="« Très ombragé l'après-midi »"
            android:textColor="@color/swiss_red"
            android:textSize="11.5sp"
            android:textStyle="italic"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Distance Badge -->
    <TextView
        android:id="@+id/tv_bench_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_distance"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="140 m"
        android:textColor="@color/swiss_red"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="6dp" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_muted" />
</LinearLayout>
